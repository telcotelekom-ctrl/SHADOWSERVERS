# PSY-TEL Hotspot Studio — Real Operation Configuration
#
# Copy this file to ".env" in the same folder (server/.env) and fill in real
# values to enable SMTP mail, Spotify track matching and a private hotspot
# access code. Never commit the real ".env" file — it holds secrets.

# --- Hotspot access code (protected.js) ---
# Passcode required to unlock the hotspot broadcast panel in the studio.
PSY_TEL_ACCESS_CODE=change-this-passcode

# --- SMTP (contact form, nodemailer) ---
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# --- Spotify (Client Credentials flow) ---
# Create an app at https://developer.spotify.com/dashboard to get these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Runtime ---
PORT=3000
